    "localization": {"en": {
      "6a8f4d5e90206485fa1d2f70": "You said there was one final condition for the armored case.",
      "6a8f4d5e90206485fa1d2f71": "Remind me what you want done at ULTRA.",
      "6a8f4d5e90206485fa1d2f72": "The tasks are complete.",
      "6a8f4d5e90206485fa1d2f73": "Go to ULTRA's main entrance. Launch a yellow signal flare, then eliminate fifteen targets on Interchange before leaving the raid alive. The message must be unmistakable.",
      "6a8f4d5e90206485fa1d2f74": "Understood. I will return when it is done.",
      "6a8f4d5e90206485fa1d2f75": "Yes, I know. You handled everything.",
      "6a8f4d5e90206485fa1d2f76": "I need the case. Right now.",
      "6a8f4d5e90206485fa1d2f77": "Here's your reward.",
      "6a8f4d5e90206485fa1d2f78": "This time, do not give it to anyone. Use it yourself.",
      "6a8f4d5e90206485fa1d2f79": "Leave"
    }}
