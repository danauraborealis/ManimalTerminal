<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Manimal.Terminal.Server</RootNamespace>
    <AssemblyName>terminal-server</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Authors>$(ModUsername)</Authors>
    <Version>$(ModVersion)</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="SemanticVersioning"><HintPath>$(SPTServerPath)\SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SPTServerPath)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SPTServerPath)\SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SPTServerPath)\SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SPTServerPath)\SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MoreBotsServer">
      <Private>false</Private>
      <HintPath>$(SPTServerPath)\user\mods\MoreBotsServer\MoreBotsServer.dll</HintPath>
    </Reference>
    <Reference Include="WTT-ServerCommonLib">
      <Private>false</Private>
      <HintPath>$(SPTServerPath)\user\mods\WTT-ServerCommonLib\WTT-ServerCommonLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLines Remove="@(_BuildInfoLines)" />
      <_BuildInfoLines Include="// auto-generated from Directory.Build.props - do not edit" />
      <_BuildInfoLines Include="namespace $(RootNamespace)" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="    internal static class BuildInfo" />
      <_BuildInfoLines Include="    {" />
      <_BuildInfoLines Include="        public const string Version = %22$(ModVersion)%22%3B" />
      <_BuildInfoLines Include="        public const string ModGuid = %22$(ModGuid)%22%3B" />
      <_BuildInfoLines Include="        public const string Name = %22$(ModUsername)$(ModDisplayName)%22%3B" />
      <_BuildInfoLines Include="        public const string Author = %22$(ModUsername)%22%3B" />
      <_BuildInfoLines Include="        public const string SourceUrl = %22$(RepositoryUrl)%22%3B" />
      <_BuildInfoLines Include="    }" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(_BuildInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <!--
    deploy dll + db + bundles.json into the dev SPT mod folder. scene/preset BUNDLES
    are NOT copied per-build — those deploy to StreamingAssets by hand or script
    (playbook phase 5: the client resolves bundle keys against StreamingAssets FIRST).
  -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(SkipDeploy)' != 'true'">
    <PropertyGroup>
      <DevModDir>$(SPTServerPath)\user\mods\ManimalTerminal</DevModDir>
    </PropertyGroup>
    <ItemGroup>
      <DbFiles Include="$(ProjectDir)db\**\*.json;$(ProjectDir)db\**\*.jsonc;$(ProjectDir)db\**\*.png;$(ProjectDir)db\**\*.jpg" />
    </ItemGroup>
    <MakeDir Directories="$(DevModDir)" />
    <Copy SourceFiles="@(DbFiles)" DestinationFiles="@(DbFiles->'$(DevModDir)\db\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(ProjectDir)bundles.json" DestinationFolder="$(DevModDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DevModDir)" />
  </Target>

</Project>
