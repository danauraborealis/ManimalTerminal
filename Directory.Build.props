<Project>
  <!-- single source of truth for version + identity, per manimal mod conventions -->
  <PropertyGroup>
    <ModVersion>0.2.2</ModVersion>
    <ModGuid>com.manimal.terminal</ModGuid>
    <ModUsername>Manimal</ModUsername>
    <ModDisplayName>Terminal</ModDisplayName>
    <RepositoryUrl>https://github.com/danauraborealis/ManimalTerminal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <SPTPath Condition="'$(SPTPath)' == ''">D:\SPT41Dev</SPTPath>
    <SPTServerPath Condition="'$(SPTServerPath)' == ''">$(SPTPath)\SPT_Runtime</SPTServerPath>
    <FikaPath Condition="'$(FikaPath)' == ''">D:\SPT41DevFika</FikaPath>
    <SkipDeploy Condition="'$(SkipDeploy)' == ''">true</SkipDeploy>
    <SkipPackage Condition="'$(SkipPackage)' == ''">true</SkipPackage>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>
</Project>
